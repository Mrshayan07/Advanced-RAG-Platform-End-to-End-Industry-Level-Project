APP_NAME=Advanced RAG Platform
APP_ENV=production
DEBUG=false

API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-strong-password@localhost:5432/ragdb

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

REDIS_URL=redis://localhost:6379/0

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=advanced-rag

CORS_ORIGINS=http://localhost:5173

RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_SIZE_MB=5

RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RAG_MAX_ITERATIONS=2

JWT_SECRET_KEY=replace-with-a-long-random-secret
# Local development only; replace with a strong secret
POSTGRES_PASSWORD=replace-with-a-strong-password
